# Henry runtime
HENRY_NAME=Henry
HENRY_USER_NAME=Dad
HENRY_PORT=7337
HENRY_HOST=127.0.0.1
HENRY_ALLOW_REMOTE_DASHBOARD=false
HENRY_DASHBOARD_TOKEN=
HENRY_PROVIDER=codex
HENRY_CODEX_MODEL=
HENRY_CLAUDE_MODEL=

# The app-level outbound gate remains enabled even though Codex runs without prompts.
HENRY_REQUIRE_OUTBOUND_APPROVAL=true

# Job applications. The profile and resume are personal files kept out of Git.
# Legacy LAVU_* variable names are still honoured as a fallback.
HENRY_JOB_PROFILE_PATH=application-profile.md
HENRY_RESUME_SOURCE_PATH=resume.md
HENRY_BROWSER_PROFILE_DIR=data/browser-profile
HENRY_BROWSER_HEADLESS=false

# Optional: used to recognise your own address. All outbound actions are still
# approval-gated by default.
DAD_EMAIL=

# Gmail OAuth desktop-app credentials downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=./data/gmail-credentials.json
GMAIL_TOKEN_PATH=./data/gmail-token.json
GMAIL_REDIRECT_URI=http://127.0.0.1:43821/oauth2callback

# Optional GitHub configuration. Henry also respects the gh CLI login.
GH_HOST=github.com

# Optional semantic embeddings. Engram works offline with hashing embeddings.
OPENAI_API_KEY=

# Optional: Telegram operator-notification channel (docs/modules/telegram.md).
# Reminders/mail-watch alerts still deliver via console + macOS notification
# when these are blank; Telegram is a fire-and-forget extra leg.
HENRY_TELEGRAM_BOT_TOKEN=
HENRY_TELEGRAM_CHAT_ID=

# Team standup group (optional): the ONLY chat the standup poller reads.
# Find it after adding the bot to your group: henry standup discover
HENRY_TELEGRAM_STANDUP_CHAT_ID=
