# Lavu runtime
LAVU_NAME=Lavu
LAVU_USER_NAME=Dad
LAVU_PORT=7337
LAVU_HOST=127.0.0.1
LAVU_PROVIDER=codex
LAVU_CODEX_MODEL=
LAVU_CLAUDE_MODEL=

# The app-level outbound gate remains enabled even though Codex runs without prompts.
LAVU_REQUIRE_OUTBOUND_APPROVAL=true

# Optional: used to recognise your own address. All outbound actions are still
# approval-gated by default.
DAD_EMAIL=

# Gmail OAuth desktop-app credentials downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=./data/gmail-credentials.json
GMAIL_TOKEN_PATH=./data/gmail-token.json
GMAIL_REDIRECT_URI=http://127.0.0.1:43821/oauth2callback

# Optional GitHub configuration. Lavu also respects the gh CLI login.
GH_HOST=github.com

# Optional semantic embeddings. Engram works offline with hashing embeddings.
OPENAI_API_KEY=
